# Copy this file to `.env` and fill in real values:
#   PowerShell:  Copy-Item .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets.

# ── Server ───────────────────
# Port the Express app listens on. Must match the port your reverse
# proxy (nginx/Cloudflare) forwards to.
PORT=3000
# "production" enables HSTS, tightens error output and — critically —
# makes the API_SECRET check below mandatory. Anything else is development.
NODE_ENV=development
# Number of reverse-proxy hops in front of the app. This is what makes
# req.ip the real client IP; get it wrong and rate limiting is bypassable.
#   1 = one proxy (nginx or Cloudflare)
#   0 = no proxy, app exposed directly
TRUST_PROXY_HOPS=1
# ── Telegram approval bot ────────────────────
# REQUIRED for payment approvals. Without these the site still runs, but
# every payment request goes unapproved.
#   1. Message @BotFather, create a bot, copy the token here.
#   2. Message your new bot, then get your chat id from @userinfobot.
#
# SECURITY: if either value ever appears in a chat, commit or screenshot,
# revoke the token in @BotFather immediately (/mybots -> API Token -> Revoke).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id-here
# Per-attempt timeout for Telegram API calls (ms). Each call is retried up
# to 3 times with exponential backoff on network errors and HTTP 429;
# 4xx errors fail immediately. Optional — defaults to 10000.
TELEGRAM_TIMEOUT_MS=10000
# ── API security ─────────────────────────────
# Master secret, 32+ characters. In production the server REFUSES TO BOOT
# if this is missing, too short, or still looks like a placeholder.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Note: at present this acts as a boot-time production guard rather than a
# per-request credential — sessions from /api/auth/session and per-session
# CSRF tokens are what actually authorise API calls.
API_SECRET=your-api-secret-here
# Comma-separated origins allowed to call the API (CORS allow-list).
# Requests from any other origin receive no CORS headers.
#
# IMPORTANT: replace localhost with your real domain before deploying, or
# your own site will be blocked from calling its own API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# ── Payment provider webhooks ────────────────────────────────
# HMAC-SHA256 shared secrets for the provider callback endpoints:
#   POST /api/webhook/safaricom
#   POST /api/webhook/airtel
#
# Each request must send an `X-Signature` header equal to
# HMAC-SHA256(secret, JSON.stringify(body)).
#
# These FAIL CLOSED: while unset, the endpoint returns 503 rather than
# accepting unverified traffic. Required before taking real money.
#
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAFARICOM_WEBHOOK_SECRET=your-safaricom-webhook-secret-here
AIRTEL_WEBHOOK_SECRET=your-airtel-webhook-secret-here
# ── Rate limiting ────────────────────────────
# Defaults used by the rateLimit() helper. Individual routes override these
# with tighter, route-specific limits (see backend/routes.js).
# Optional — both default to the values shown.
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=10
# ── Customer support details ─────────────────
# Served to the front end via GET /api/config. Optional — sensible
# fallbacks are built into the code.
SUPPORT_PHONE=+254712345678
SUPPORT_EMAIL=support@starlink-ke.co.ke
# ── Audit log rotation ──────────────────────────────
# The audit trail is written to a file in the project directory. Once it
# exceeds AUDIT_ROTATE_BYTES it is rotated to a dated archive, and archives
# older than AUDIT_RETAIN_DAYS are pruned on the next rotation.
#
# Rotated archives contain masked phone numbers and audit events — they are
# NOT covered by the .gitignore rule for *.log if you rename the extension.
# Keep this directory out of version control.
#
# Optional — defaults to 10 MB and 30 days.
AUDIT_ROTATE_BYTES=10485760
AUDIT_RETAIN_DAYS=30
